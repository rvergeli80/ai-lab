# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.envrc
.pytest_cache/
.mypy_cache/

# Environment / secrets
.env
.env.*
!.env.example
!config/env/.env.example
config/env/.env.local
credentials/.env

# Local downloaded models
/models/
/resource-engine/models/
*.gguf
*.bin
*.safetensors
.ollama/

# Runtime data
/infrastructure/volumes/
/backups/
webui.db*
*.log

# Nested repositories
/nevermine-ai-starter/

# Vector databases
chroma/
qdrant_storage/
faiss/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Cache
.cache/

# Temporary
tmp/
temp/
